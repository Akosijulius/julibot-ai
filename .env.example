# JULIBOT Development Environment
# Copy from .env.example and customize for your environment.

# Environment: development, staging, or production
ENVIRONMENT=development

# Database (SQLite for local development)
# For production use PostgreSQL, e.g.:
#   DATABASE_URL=postgresql://user:password@host:5432/julibot
DATABASE_URL=sqlite:///./julibot.db

# PostgreSQL connection-pool sizing (ignored by SQLite)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Data retention (days) — background task purges stale rows past these windows.
# Conversation/message content is only removed on explicit account deletion.
SESSION_RETENTION_DAYS=30
USAGE_RETENTION_DAYS=365
RETENTION_INTERVAL_MINUTES=60

# Security
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — comma-separated list of allowed browser origins. Defaults cover local
# development. In production set to your real frontend domain(s).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# AI Providers
# Primary: Google Gemini — handles all interactive chat
GOOGLE_API_KEY=your-gemini-api-key-here
# Secondary: Groq — fallback when Gemini is unavailable, titles, summaries
GROQ_API_KEY=your-groq-api-key-here

# Model Configuration
LLM_PRIMARY_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
LLM_DEFAULT_MODEL=gemini-3.5-flash

# AI generation cap — hard ceiling on per-response output tokens per turn.
MAX_OUTPUT_TOKENS=4096

# Context Management
MAX_HISTORY_MESSAGES=20
MAX_CONTEXT_TOKENS=30000
ENABLE_SUMMARIZATION=true
SUMMARIZATION_THRESHOLD=30

# Streaming
ENABLE_STREAMING=true

# Per-user daily AI usage quotas (registered / guest)
QUOTA_ENABLED=true
QUOTA_DAILY_REQUESTS=200
QUOTA_DAILY_OUTPUT_TOKENS=500000
QUOTA_GUEST_DAILY_REQUESTS=50
QUOTA_GUEST_DAILY_OUTPUT_TOKENS=50000

# Request limits — reject bodies larger than this (guards oversized payloads).
MAX_BODY_SIZE_BYTES=5000000

# Google OAuth (optional — needed for "Continue with Google")
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Server
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Rate Limiting (requests per minute)
RATE_LIMIT_CHAT=20
RATE_LIMIT_AUTH=10
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_IMPORT=10

# Proxy trust — set True ONLY when deployed behind a trusted reverse proxy
# (e.g. Render). This makes rate limiting use the real client IP from the
# X-Forwarded-For header instead of letting clients spoof it.
# Leave False when the app is exposed directly to the internet.
TRUST_PROXY_HEADERS=false

# Production checklist:
# 1. Set ENVIRONMENT=production
# 2. Set a strong SECRET_KEY (python -c "import secrets; print(secrets.token_urlsafe(32))")
# 3. Set ALLOWED_ORIGINS to your real domain, e.g. ALLOWED_ORIGINS=https://julibot.onrender.com
# 4. Use a PostgreSQL DATABASE_URL (not SQLite) for real deployments
# 5. DEBUG=false (turns off SQL echo logging)
