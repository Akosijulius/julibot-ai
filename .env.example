# JULIBOT Development Environment
# Copy from .env.example and customize for your environment.

# Environment: development, staging, or production
ENVIRONMENT=development

# Database (SQLite for local development)
DATABASE_URL=sqlite:///./julibot.db

# Security
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Providers
# Primary: Google Gemini — handles all interactive chat
GOOGLE_API_KEY=your-gemini-api-key-here
# Secondary: Groq — fallback when Gemini is unavailable, titles, summaries
GROQ_API_KEY=your-groq-api-key-here

# Model Configuration
LLM_PRIMARY_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
LLM_DEFAULT_MODEL=gemini-3.5-flash

# Context Management
MAX_HISTORY_MESSAGES=20
MAX_CONTEXT_TOKENS=30000
ENABLE_SUMMARIZATION=true
SUMMARIZATION_THRESHOLD=30

# Streaming
ENABLE_STREAMING=true

# Google OAuth (optional — needed for "Continue with Google")
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Server
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Rate Limiting (requests per minute)
RATE_LIMIT_CHAT=20
RATE_LIMIT_AUTH=10
RATE_LIMIT_GLOBAL=100

# Proxy trust — set True ONLY when deployed behind a trusted reverse proxy
# (e.g. Render). This makes rate limiting use the real client IP from the
# X-Forwarded-For header instead of letting clients spoof it.
# Leave False when the app is exposed directly to the internet.
TRUST_PROXY_HEADERS=false

# Production checklist:
# 1. Set ENVIRONMENT=production
# 2. Set a strong SECRET_KEY (python -c "import secrets; print(secrets.token_urlsafe(32))")
# 3. Set ALLOWED_ORIGINS to your real domain, e.g. ALLOWED_ORIGINS=https://julibot.onrender.com
# 4. Use a PostgreSQL DATABASE_URL (not SQLite) for real deployments
# 5. DEBUG=false (turns off SQL echo logging)
